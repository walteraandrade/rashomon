# Every variable the project reads. Copy to .env.local and fill what you need.
# Defaults are in docs/operations.md; empty here means "use the default".

# Server
PORT=

# Database. DATA_DIR is the embedded PGlite directory; memory:// is in-memory.
# DATABASE_URL (or POSTGRES_URL) switches every command to a managed Postgres.
DATA_DIR=
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
PG_POOL_MAX=

# Collectors
BSKY_HANDLE=
BSKY_APP_PASSWORD=
GKG_SLOTS=

# Writes and indexing
WRITE_BATCH_ROWS=
WRITE_BATCH_DOCS=
ANALYZE_MIN_DOCS=
MIN_PHRASE_COUNT=
MIN_PHRASE_PERCENT=

# Testimony scoring
TESTIMONY_SCORER=
TESTIMONY_MODEL=
TESTIMONY_REVISION=
TESTIMONY_DTYPE=
MODEL_DIR=

# HTTP caching, in whole hours
API_CACHE_HOURS=
API_CACHE_TREND_HOURS=
API_CACHE_STATIC_HOURS=
API_CACHE_SWR_HOURS=

# Instrumentation
PERF=
PERF_LOG=
