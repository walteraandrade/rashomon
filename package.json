{
  "name": "rashomon",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "dev": "tsx src/server.ts",
    "build": "esbuild public/js/app.js --bundle --minify --format=esm --target=es2022 --outfile=public/bundle.js --log-level=warning",
    "reindex": "tsx src/reindex.ts",
    "purge": "tsx src/purge.ts",
    "score": "tsx src/score.ts",
    "export-docs": "tsx src/export-docs.ts",
    "bench": "tsx src/bench.ts",
    "bench:writes": "tsx src/bench-writes.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "DATA_DIR=memory:// node --import tsx --test test/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "push": "tsx src/push.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@huggingface/transformers": "^4.2.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.17.0"
}
